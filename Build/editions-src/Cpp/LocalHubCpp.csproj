    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <AssemblyName>LocalHubCpp</AssemblyName>
    <RootNamespace>LocalHubCppApp</RootNamespace>
    <ApplicationIcon>..\..\..\Resources\icon-cpp.ico</ApplicationIcon>
